rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Profile document
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && incoming().userId == userId
        && incoming().email is string
        && incoming().email.size() <= 150;
      allow update: if isOwner(userId)
        && incoming().userId == userId;
      allow delete: if isOwner(userId);

      // User's private tracks collection
      match /tracks/{trackId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(trackId)
          && incoming().userId == userId
          && incoming().title is string
          && incoming().title.size() <= 200;
        allow update: if isOwner(userId)
          && incoming().userId == userId;
        allow delete: if isOwner(userId);
      }

      // User's AI generated music
      match /generatedMusic/{musicId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(musicId)
          && incoming().userId == userId
          && incoming().prompt is string
          && incoming().prompt.size() <= 1000;
        allow update: if isOwner(userId)
          && incoming().userId == userId;
        allow delete: if isOwner(userId);
      }
    }
  }
}
